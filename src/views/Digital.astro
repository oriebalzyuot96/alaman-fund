---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { data, ui, type Lang } from '../lib/i18n';
import { crumbs } from '../lib/crumbs';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = ui[lang];
const page = data[lang].pages[slug];
const flat = page.sections.flat();
const NAMES: Record<string, string> = { zain: 'Zain Cash', orangem: 'Orange Money', Dinarak: 'Dinarak', uwallet: 'U Wallet', eFAWATEERcom: 'eFAWATEERcom', talabat: 'Talabat', careem: 'Careem' };
const isIntro = (s: string) => /^(You can|Support Al Aman|يمكنك التبرع)/.test(s);

type Wallet = { name: string; logo: string; steps: string[]; group: number };
const intros: string[] = [];
const wallets: Wallet[] = [];
for (const b of flat) {
  if (b.t === 'p' && isIntro(b.text!)) intros.push(b.text!);
  else if (b.t === 'img') {
    const key = Object.keys(NAMES).find((k) => b.src!.includes(k)) || 'wallet';
    wallets.push({ name: NAMES[key] || key, logo: b.src!, steps: [], group: intros.length - 1 });
  } else if (b.t === 'p' && wallets.length) wallets[wallets.length - 1].steps.push(b.text!);
}
---
<Base lang={lang} title={page.title}>
  <PageHero lang={lang} title={page.title} kicker={t.giveKicker} lead={intros[0]} crumbs={crumbs(lang, slug)} />

  <section class="section dg">
    <div class="container dg__grid">
      <div class="dg__left">
        {intros.map((intro, g) => (
          <div class="dg__group" data-reveal style={`--d:${g}`}>
            {g > 0 && <p class="dg__intro">{intro}</p>}
            <div class="dg__tabs" role="tablist">
              {wallets.map((w, i) => w.group === g && (
                <button role="tab" type="button" class:list={['dg__tab', { 'is-on': i === 0 }]} aria-selected={i === 0 ? 'true' : 'false'} data-w={i}>
                  <img src={w.logo} alt="" loading="lazy" />
                  <span>{w.name}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="dg__phone" data-reveal style="--d:2">
        <div class="dg__notch" aria-hidden="true"></div>
        {wallets.map((w, i) => (
          <div class:list={['dg__screen', { 'is-on': i === 0 }]} data-panel={i} role="tabpanel">
            <header>
              <img src={w.logo} alt="" loading="lazy" />
              <strong>{w.name}</strong>
            </header>
            <ol>
              {w.steps.map((s, k) => <li style={`--k:${k}`}><span>{k + 1}</span><p>{s}</p></li>)}
            </ol>
            <div class="dg__done" style={`--k:${w.steps.length}`}>✓ {lang === 'ar' ? 'شكراً لعطائك' : 'Thank you for giving'}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.dg__tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('.dg__screen')];
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((x) => (x.classList.toggle('is-on', x === tab), x.setAttribute('aria-selected', String(x === tab))));
      panels.forEach((p) => p.classList.toggle('is-on', p.dataset.panel === tab.dataset.w));
    }),
  );
</script>

<style lang="scss">
  @use '../styles/mixins' as *;
  @use '../styles/tokens' as *;

  .dg__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(30px, 6vw, 100px);
    align-items: start;
    @include down($bp-md) {
      grid-template-columns: 1fr;
    }
  }
  .dg__left {
    display: grid;
    gap: 40px;
  }
  .dg__group {
    display: grid;
    gap: 16px;
  }
  .dg__intro {
    font: 400 1.3rem/1.4 var(--font-display);
    color: var(--brand);
  }
  .dg__tabs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .dg__tab {
    display: grid;
    gap: 12px;
    justify-items: center;
    padding: 20px 14px 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1.5px solid var(--line);
    font-weight: 700;
    font-size: 0.9rem;
    transition: border-color 0.3s, transform 0.4s var(--ease-out), box-shadow 0.4s;
    @include focus-ring;
    img {
      height: 54px;
      width: auto;
      max-width: 110px;
      object-fit: contain;
    }
    &:hover {
      transform: translateY(-3px);
    }
    &:global(.is-on) {
      border-color: $sun-500;
      box-shadow: 0 18px 36px -18px rgba(246, 141, 46, 0.6);
    }
  }

  .dg__phone {
    position: sticky;
    top: 110px;
    width: min(360px, 100%);
    margin-inline: auto;
    aspect-ratio: 9 / 18.5;
    border-radius: 48px;
    padding: 14px;
    background: linear-gradient(145deg, #1b3f44, #071e22);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.08), 0 50px 80px -30px rgba(0, 38, 43, 0.6);
    @include down($bp-md) {
      position: relative;
      top: 0;
    }
  }
  .dg__notch {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    width: 90px;
    height: 24px;
    border-radius: 20px;
    background: #071e22;
    z-index: 3;
  }
  .dg__screen {
    position: absolute;
    inset: 14px;
    border-radius: 36px;
    background: var(--bg);
    overflow: hidden;
    display: none;
    flex-direction: column;
    &:global(.is-on) {
      display: flex;
    }
    header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 58px 22px 20px;
      background: linear-gradient(135deg, $teal-700, $teal-900);
      color: #fff;
      img {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: #fff;
        object-fit: contain;
        padding: 4px;
      }
    }
    ol {
      list-style: none;
      margin: 0;
      padding: 18px;
      display: grid;
      gap: 10px;
      overflow-y: auto;
    }
    li {
      display: flex;
      gap: 12px;
      padding: 12px;
      border-radius: 14px;
      background: var(--surface);
      border: 1px solid var(--line);
      font-size: 0.85rem;
      line-height: 1.45;
      animation: dg-step 0.6s var(--ease-out) both;
      animation-delay: calc(var(--k) * 140ms);
      span {
        flex: none;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: $sun-500;
        color: #fff;
        font-weight: 800;
        font-size: 0.78rem;
      }
    }
  }
  .dg__done {
    margin: auto 18px 22px;
    padding: 12px;
    border-radius: 14px;
    text-align: center;
    font-weight: 700;
    background: rgba(111, 162, 135, 0.18);
    color: $sage;
    animation: dg-step 0.6s var(--ease-out) both;
    animation-delay: calc(var(--k) * 140ms + 200ms);
  }
  @keyframes dg-step {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
