---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Illo from '../components/Illo.astro';
import { data, ui, type Lang, type Block } from '../lib/i18n';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = ui[lang];
const page = data[lang].pages[slug];
const flat = page.sections.flat();

// split into chunks at each h2
const chunks: { title: string; blocks: Block[] }[] = [];
for (const b of flat) {
  if (b.t === 'h2') chunks.push({ title: b.text!, blocks: [] });
  else chunks[chunks.length - 1]?.blocks.push(b);
}
const tracks = chunks.slice(0, 3);
const criteria = chunks[3];
const trackImgs = ['/media/2026/05/graduates-.jpg', '/media/2026/05/IMG_3983.jpeg', '/media/2026/05/vocational-training-1.jpg'];
const applyHref = flat.find((b) => b.t === 'a' && /eligibility/.test(b.href!))?.href || 'https://eligibility.alamanfund.jo/';
const crit = criteria?.blocks || [];
const groups = crit.map((b, i) => (b.t === 'h4' ? { title: b.text!, pdf: crit.slice(i + 1).find((x) => x.t === 'a' && /\.pdf$/.test(x.href!)) } : null)).filter(Boolean) as { title: string; pdf?: Block }[];
const critText = crit.filter((b) => b.t === 'p').map((b) => b.text!);
---
<Base lang={lang} title={page.title}>
  <PageHero lang={lang} title={page.title} kicker={lang === 'ar' ? 'المنح الدراسية' : 'Scholarships'} lead={tracks[0]?.blocks.find((b) => b.t === 'p')?.text} image={trackImgs[0]}>
    <div><a class="btn" href={applyHref} target="_blank" rel="noopener">{t.apply} →</a></div>
  </PageHero>

  <section class="section ap">
    <div class="container ap__tracks">
      {tracks.map((tr, i) => (
        <article class="ap__track" data-reveal data-tilt style={`--d:${i}`}>
          <div class="ap__media"><img src={trackImgs[i]} alt="" loading="lazy" /></div>
          <div class="ap__body">
            <span class="ap__n">0{i + 1}</span>
            <h2>{tr.title}</h2>
            <p>{tr.blocks.find((b) => b.t === 'p')?.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {criteria && (
    <section class="section ap-crit">
      <div class="container ap-crit__grid">
        <div class="ap-crit__head">
          <p class="kicker" data-reveal>{critText[0]}</p>
          <h2 class="h2" data-reveal style="--d:1">{criteria.title}</h2>
          <p class="lead" data-reveal style="--d:2">{critText[1]}</p>
        </div>
        <div class="ap-crit__cards">
          {groups.map((g, i) => (
            <a class="ap-doc" href={g.pdf?.href} target="_blank" rel="noopener" data-reveal style={`--d:${i}`}>
              <span class="ap-doc__ico" aria-hidden="true">PDF</span>
              <span class="ap-doc__txt">
                <strong>{g.title}</strong>
                <small>{g.pdf?.text}</small>
              </span>
              <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m-3.5-3.5L8 10l3.5-3.5M3 13h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            </a>
          ))}
        </div>
      </div>
      <div class="container">
        <div class="ap-band dark-surface" data-reveal>
          <div class="ap-band__illo"><Illo name="apply" /></div>
          <div>
            <h2>{lang === 'ar' ? 'جاهز لبدء رحلتك؟' : 'Ready to start your journey?'}</h2>
            <p>{lang === 'ar' ? 'قدّم طلبك عبر بوابة الأهلية الإلكترونية.' : 'Submit your application through the online eligibility portal.'}</p>
          </div>
          <a class="btn" href={applyHref} target="_blank" rel="noopener">{t.apply} →</a>
        </div>
      </div>
    </section>
  )}
</Base>

<style lang="scss">
  @use '../styles/mixins' as *;
  @use '../styles/tokens' as *;

  .ap__tracks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    @include down($bp-md) {
      grid-template-columns: 1fr;
    }
  }
  .ap__track {
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s;
    &:hover {
      box-shadow: var(--shadow-lift);
    }
  }
  .ap__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1.2s var(--ease-out);
    }
    .ap__track:hover & img {
      transform: scale(1.06);
    }
  }
  .ap__body {
    display: grid;
    gap: 12px;
    padding: 26px 28px 32px;
    h2 {
      font-size: 1.7rem;
    }
    p {
      color: var(--text-2);
      font-size: 0.96rem;
    }
  }
  .ap__n {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: $sun-600;
  }
  .ap-crit {
    background: var(--bg-2);
  }
  .ap-crit__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 80px);
    align-items: center;
    @include down($bp-md) {
      grid-template-columns: 1fr;
    }
  }
  .ap-crit__head {
    display: grid;
    gap: 18px;
  }
  .ap-crit__cards {
    display: grid;
    gap: 14px;
  }
  .ap-doc {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 22px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    transition: transform 0.4s var(--ease-out), border-color 0.3s;
    &:hover {
      transform: translateX(6px);
      border-color: $sun-500;
    }
    :global([dir='rtl']) &:hover {
      transform: translateX(-6px);
    }
    svg {
      margin-inline-start: auto;
      color: $sun-600;
      flex: none;
    }
  }
  .ap-doc__ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 54px;
    height: 64px;
    border-radius: 10px;
    background: $teal-800;
    color: #fff;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    clip-path: polygon(0 0, 72% 0, 100% 22%, 100% 100%, 0 100%);
  }
  .ap-doc__txt {
    display: grid;
    gap: 4px;
    small {
      color: var(--text-2);
    }
  }
  .ap-band {
    margin-top: clamp(50px, 7vw, 90px);
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 30px;
    align-items: center;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-l);
    background: radial-gradient(100% 140% at 100% 0%, $teal-700, $teal-900);
    color: #fff;
    h2 {
      font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    }
    p {
      opacity: 0.8;
      margin-top: 6px;
    }
    @include down($bp-md) {
      grid-template-columns: 1fr;
      .ap-band__illo {
        width: 120px;
      }
    }
  }
</style>
