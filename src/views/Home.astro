---
import { withBase } from '../lib/base';
import Base from '../layouts/Base.astro';
import HeroScene from '../islands/HeroScene';
import Illo from '../components/Illo.astro';
import Video from '../components/Video.astro';
import NewsCard from '../components/NewsCard.astro';
import JourneyFilm from '../components/JourneyFilm.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { data, ui, href, fmtDate, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const D = data[lang];
const home = D.pages[''];
const all = home.sections.flat();
const intro = all.find((b) => b.t === 'p')!.text!;
const storyIdx = all.findIndex((b) => b.t === 'h2');
const story = { kicker: all[storyIdx - 1]?.text, title: all[storyIdx].text, body: all[storyIdx + 1]?.text };
const stats = all.filter((b) => b.t === 'stat');

const programsPage = D.pages['who-we-are/our-programs'].sections.flat();
const programs = programsPage
  .map((b, i) => (b.t === 'h2' ? { title: b.text!, text: programsPage[i + 1]?.text || '' } : null))
  .filter(Boolean) as { title: string; text: string }[];
const programIllos = ['education', 'living', 'capacity', 'psycho', 'inclusion'] as const;
const firstSentence = (s: string) => (s.match(/^.+?[.!؟。](\s|$)/)?.[0] || s).trim();

const royal = D.news.filter((n) => n.category === 'royal');
const news = D.news.filter((n) => n.category !== 'royal').slice(0, 5);

// Giving tiers parsed from the individual-donation page ("1,500 JOD Covers …")
const ind = D.pages['ways-to-give/individual-donation'].sections.flat().filter((b) => b.t === 'p');
const tiers = ind
  .map((b, i) => {
    const m = b.text!.match(/^([\d,.]+)\s*(JOD|دينار أردني)\s*(.*)$/);
    return m ? { name: ind[i - 1].text!, amount: m[1], cur: m[2], text: m[3] } : null;
  })
  .filter(Boolean) as { name: string; amount: string; cur: string; text: string }[];
const hoursFrom = lang === 'ar' ? '2.5 دينار شهرياً' : '2.5 JOD / month';

const journey = [
  { illo: 'care', title: lang === 'ar' ? 'مغادرة دار الرعاية عند 18' : 'Leaving care at 18', text: lang === 'ar' ? 'يفقد الشباب الدعم المؤسسي ويواجهون الحياة وحدهم دون شبكة أمان عائلية.' : 'Youth lose institutional support and face adult life alone, without a family safety net.' },
  { illo: 'education', title: programs[0]?.title, text: firstSentence(programs[0]?.text || '') },
  { illo: 'living', title: programs[1]?.title, text: firstSentence(programs[1]?.text || '') },
  { illo: 'capacity', title: programs[2]?.title, text: firstSentence(programs[2]?.text || '') },
  { illo: 'job', title: lang === 'ar' ? 'التخرج والوظيفة الأولى' : 'Graduation & a first job', text: `${stats.find((s) => s.value.includes('78'))?.value} ${stats.find((s) => s.value.includes('78'))?.text}` },
] as const;
const excellence = D.pages['pursuing-excellence'].sections.flat();
const award = excellence.find((b) => b.t === 'h2' && excellence.indexOf(b) > 0);
const awardText = excellence.find((b) => b.t === 'p')?.text;
const num = (v: string) => parseInt(v.replace(/[^\d]/g, ''));
const statIcons: IconName[] = ['clock', 'users', 'heart', 'cap', 'briefcase', 'book', 'growth'];

const film = {
  kicker: lang === 'ar' ? 'فيلم ثلاثي الأبعاد' : 'A 3D short film',
  title: lang === 'ar' ? 'رحلة الأمان: طريق آمن نحو المستقبل' : 'The Al Aman journey: a safe path to the future',
  chapters: [
    { at: 0, icon: 'home', title: journey[0].title, text: journey[0].text },
    { at: 4, icon: 'cap', title: programs[0]?.title, text: firstSentence(programs[0]?.text || '') },
    { at: 9, icon: 'shield', title: programs[1]?.title, text: firstSentence(programs[1]?.text || '') },
    { at: 13.5, icon: 'growth', title: programs[2]?.title, text: firstSentence(programs[2]?.text || '') },
    { at: 17.5, icon: 'users', title: `${programs[3]?.title} · ${programs[4]?.title}`, text: firstSentence(programs[4]?.text || '') },
    { at: 21, icon: 'sun', title: journey[4].title, text: journey[4].text },
  ] as { at: number; icon: IconName; title: string; text: string }[],
};

// A real quote from Her Majesty, taken from the royal news coverage.
const quoteSrc = royal.find((n) => /^Queen Rania:/i.test(n.title));
const arQuote = royal
  .flatMap((n) => n.body.filter((b) => b.t === 'p').map((b) => ({ n, m: b.text!.match(/[«“"]([^»”"]{50,240})[»”"]/) })))
  .find((x) => x.m);
const quote =
  lang === 'en' && quoteSrc
    ? { text: quoteSrc.title.split(':').slice(1).join(':').trim(), href: href(lang, `news/${quoteSrc.id}`) }
    : arQuote
      ? { text: arQuote.m![1].trim(), href: href(lang, `news/${arQuote.n.id}`) }
      : null;

const awards = excellence
  .map((b, i) => (b.t === 'img' && excellence[i + 1]?.t === 'h2' ? { img: b.src!, title: excellence[i + 1].text! } : null))
  .filter(Boolean)
  .slice(0, 3) as { img: string; title: string }[];
const partnerLogos = D.pages['ways-to-give/our-partners'].sections.flat().filter((b) => b.t === 'img').map((b) => b.src!);
const tracks = D.pages['application-portal'].sections.flat().filter((b) => b.t === 'h2').slice(0, 3).map((b) => b.text!);
---
<Base lang={lang} title={t.orgName} scene>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__canvas" aria-hidden="true"><HeroScene client:only="react" rtl={lang === "ar"} /></div>
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="container hero__in">
      <p class="kicker hero__kicker" data-intro style="--d:0">{t.heroKicker}</p>
      <h1 class="hero__title">
        <span class="hero__line"><span data-intro style="--d:1">{t.heroTitleA}</span></span>
        <span class="hero__line"><span data-intro style="--d:2">{t.heroTitleB}</span></span>
        <span class="hero__line hero__line--sun"><span data-intro style="--d:3"><em>{t.heroTitleC}</em></span></span>
      </h1>
      <p class="lead hero__lead" data-intro style="--d:4">{intro}</p>
      <div class="hero__ctas" data-intro style="--d:5">
        <a class="btn" href={href(lang, 'ways-to-give/donate')}><Icon name="heart" size={18} /> {t.donate}</a>
        <a class="btn btn--ghost" href={href(lang, 'application-portal')}><Icon name="cap" size={18} /> {t.apply}</a>
      </div>
    </div>
    <div class="hero__aside container" data-intro style="--d:6">
      <div class="hero__chip">
        <strong><span data-count={num(stats[1].value)}>0</span></strong>
        <span>{stats[1].text}</span>
      </div>
      <a href="#story" class="hero__scroll"><span>{t.scroll}</span><i></i></a>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => programs.map((p) => <span>{p.title}<i>✦</i></span>))}
    </div>
  </div>

  <!-- STORY -->
  <section class="section story" id="story">
    <div class="container story__grid">
      <div class="story__text">
        <p class="kicker" data-reveal>{story.kicker}</p>
        <h2 class="h2" data-reveal style="--d:1">{story.title}</h2>
        <p class="lead" data-reveal style="--d:2">{story.body}</p>
        <a class="link-arrow" href={href(lang, 'who-we-are')} data-reveal style="--d:3">{t.learnMore} <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></a>
      </div>
      <div class="story__collage">
        <figure class="story__img story__img--a" data-reveal="clip" data-parallax="-0.06"><img src={withBase("/media/2026/05/graduates-.jpg")} alt="" loading="lazy" /></figure>
        <figure class="story__img story__img--b" data-reveal="clip" style="--d:2" data-parallax="0.08"><img src={withBase("/media/2026/05/vocational-training-1.jpg")} alt="" loading="lazy" /></figure>
        <div class="story__badge" data-reveal style="--d:3">
          <strong>2006</strong>
          <span>{lang === 'ar' ? 'مبادرة جلالة الملكة رانيا العبدالله' : 'A royal initiative by Her Majesty Queen Rania Al Abdullah'}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPACT -->
  <section class="section impact dark-surface">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-reveal>{lang === 'ar' ? 'أثرنا' : 'Our impact'}</p>
        <h2 class="h2" data-reveal style="--d:1">{t.impact}</h2>
      </div>
      <div class="bento">
        {stats.map((s, i) => {
          const n = num(s.value);
          return (
            <div class:list={['bento__it', `bento__it--${i}`]} data-reveal data-tilt style={`--d:${i % 4}`}>
              <span class="bento__icon"><Icon name={statIcons[i]} size={20} /></span>
              {s.value.includes('%') && (
                <svg class="bento__ring" viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="18" /><circle class="bento__ringFill" cx="22" cy="22" r="18" pathLength="100" style={`--p:${num(s.value)}`} /></svg>
              )}
              <strong>{isNaN(n) ? s.value : <><span data-count={n}>0</span>{s.value.includes('%') ? '%' : ''}</>}</strong>
              <span>{s.text}</span>
              {i === 1 && <div class="bento__orb" aria-hidden="true"></div>}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FILM: the 3D journey -->
  <JourneyFilm kicker={film.kicker} title={film.title} chapters={film.chapters} labels={{ play: t.watch, pause: lang === 'ar' ? 'إيقاف مؤقت' : 'Pause' }} />

  <!-- PROGRAMS -->
  <section class="section programs">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="kicker" data-reveal>{t.programsKicker}</p>
          <h2 class="h2" data-reveal style="--d:1">{t.programsTitle}</h2>
        </div>
        <a class="link-arrow" href={href(lang, 'who-we-are/our-programs')} data-reveal>{D.pages['who-we-are/our-programs'].title} <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></a>
      </div>
      <div class="pgrid">
        {programs.map((p, i) => (
          <a class="pcard" href={href(lang, `who-we-are/our-programs#p${i + 1}`)} data-reveal data-tilt style={`--d:${i}`}>
            <div class="pcard__illo"><Illo name={programIllos[i]} /></div>
            <span class="pcard__n">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{firstSentence(p.text)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FILM -->
  <section class="section film dark-surface">
    <div class="container film__grid">
      <div class="film__text">
        <p class="kicker" data-reveal>{t.filmKicker}</p>
        <h2 class="h2" data-reveal style="--d:1">{award?.text}</h2>
        <p class="lead" data-reveal style="--d:2">{firstSentence(awardText || "")}</p>
        <a class="link-arrow" href={href(lang, 'pursuing-excellence')} data-reveal style="--d:3">{D.pages['pursuing-excellence'].title} <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></a>
      </div>
      <Video id="P4qWuysF2G8" title={t.filmTitle} label={t.watch} poster={withBase("/media/2026/05/The-Order-of-Al-Istiqlal-Independence-of-the-First-Degree.jpeg")} />
    </div>
  </section>

  <!-- ROYAL -->
  <section class="section royal">
    <div class="container section-head section-head--row">
      <div>
        <p class="kicker" data-reveal>{t.royalKicker}</p>
        <h2 class="h2" data-reveal style="--d:1">{all.find((b, i) => b.t === 'h2' && i > storyIdx)?.text}</h2>
      </div>
      <div class="royal__nav" data-reveal>
        <button type="button" data-scroll="-1" aria-label="Previous">←</button>
        <button type="button" data-scroll="1" aria-label="Next">→</button>
      </div>
    </div>
    <div class="royal__rail" id="royal-rail">
      {royal.map((n, i) => (
        <a class="rcard" href={href(lang, `news/${n.id}`)} data-reveal style={`--d:${i % 4}`}>
          <img src={n.image} alt="" loading="lazy" />
          <div class="rcard__body">
            <time>{fmtDate(lang, n.date)}</time>
            <h3>{n.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  {quote && (
    <section class="section quote">
      <div class="container quote__in">
        <span class="quote__mark" aria-hidden="true"><Icon name="quote" size={56} /></span>
        <blockquote data-reveal>
          <p>{quote.text}</p>
          <footer>
            <strong>{lang === 'ar' ? 'جلالة الملكة رانيا العبدالله' : 'Her Majesty Queen Rania Al Abdullah'}</strong>
            <span>{lang === 'ar' ? 'مؤسِّسة صندوق الأمان' : 'Founder of Al Aman Fund'}</span>
          </footer>
        </blockquote>
        <a class="link-arrow" href={quote.href} data-reveal>{t.readMore} <Icon name="arrow" size={16} /></a>
      </div>
    </section>
  )}

  <!-- AWARDS -->
  <section class="section awards">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="kicker" data-reveal>{lang === 'ar' ? 'التميّز' : 'Recognition'}</p>
          <h2 class="h2" data-reveal style="--d:1">{D.pages['pursuing-excellence'].title}</h2>
        </div>
        <a class="link-arrow" href={href(lang, 'pursuing-excellence')} data-reveal>{t.learnMore} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="awards__grid">
        {awards.map((a, i) => (
          <a class="award" href={href(lang, 'pursuing-excellence')} data-reveal data-tilt style={`--d:${i}`}>
            <div class="award__img"><img src={a.img} alt="" loading="lazy" /></div>
            <span class="award__badge"><Icon name="award" size={20} /></span>
            <h3>{a.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section class="section news">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="kicker" data-reveal>{t.newsKicker}</p>
          <h2 class="h2" data-reveal style="--d:1">{t.newsTitle}</h2>
        </div>
        <a class="link-arrow" href={href(lang, 'news')} data-reveal>{t.allNews} <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></a>
      </div>
      <div class="ngrid">
        {news.map((p, i) => <NewsCard lang={lang} post={p} big={i === 0} i={i} />)}
      </div>
    </div>
  </section>

  <!-- PARTNERS -->
  <section class="partners" aria-label={D.pages['ways-to-give/our-partners'].title}>
    <div class="container partners__head">
      <p class="kicker" data-reveal>{D.pages['ways-to-give/our-partners'].title}</p>
      <a class="link-arrow" href={href(lang, 'ways-to-give/our-partners')} data-reveal>{t.learnMore} <Icon name="arrow" size={16} /></a>
    </div>
    {[0, 1].map((row) => (
      <div class:list={['partners__row', { 'partners__row--rev': row === 1 }]} aria-hidden="true">
        <div class="partners__track">
          {[0, 1].map(() => partnerLogos.filter((_, i) => i % 2 === row).map((src) => <span class="partners__logo"><img src={src} alt="" loading="lazy" /></span>))}
        </div>
      </div>
    ))}
  </section>

  <!-- YOUTH -->
  <section class="section youth">
    <div class="container">
      <div class="youth__box dark-surface" data-reveal>
        <div class="youth__text">
          <p class="kicker">{lang === 'ar' ? 'للشباب' : 'For young people'}</p>
          <h2 class="h2">{lang === 'ar' ? 'غادرت دار الرعاية أو تواجه ظروفاً صعبة؟ صندوق الأمان معك.' : 'Leaving care, or facing hard circumstances? Al Aman is here for you.'}</h2>
          <ul class="youth__tracks">
            {tracks.map((tr, i) => <li><Icon name={(['cap', 'book', 'briefcase'] as IconName[])[i]} size={18} /> {tr}</li>)}
          </ul>
          <div class="youth__ctas">
            <a class="btn" href="https://eligibility.alamanfund.jo/" target="_blank" rel="noopener"><Icon name="check" size={18} /> {t.apply}</a>
            <a class="btn btn--ghost" href={href(lang, 'application-portal')}>{D.pages['application-portal'].title}</a>
          </div>
        </div>
        <div class="youth__illo"><Illo name="apply" /></div>
      </div>
    </div>
  </section>

  <!-- GIVE -->
  <section class="section give">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-reveal>{t.giveKicker}</p>
        <h2 class="h2" data-reveal style="--d:1">{D.pages['ways-to-give/individual-donation'].title}</h2>
      </div>
      <div class="tiers">
        {tiers.map((tr, i) => (
          <div class:list={['tier', { 'tier--hot': i === 1 }]} data-reveal data-tilt style={`--d:${i}`}>
            <h3>{tr.name}</h3>
            <p class="tier__price"><strong>{tr.amount}</strong> {tr.cur}</p>
            <p>{tr.text}</p>
            <a class:list={['btn', { 'btn--ghost': i !== 1 }]} href={href(lang, 'ways-to-give/donate')}>{t.donate}</a>
          </div>
        ))}
        <div class="tier tier--alt" data-reveal data-tilt style="--d:2">
          <h3>{D.pages['ways-to-give/employee-deduction-program'].title}</h3>
          <p class="tier__price"><strong>{hoursFrom.split(' ')[0]}</strong> {hoursFrom.split(' ').slice(1).join(' ')}</p>
          <p>{D.pages['ways-to-give/employee-deduction-program'].sections.flat().find((b) => b.t === 'p')?.text?.slice(0, 150)}…</p>
          <a class="btn btn--ghost" href={href(lang, 'ways-to-give/employee-deduction-program')}>{t.joinProgram}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Hero copy enters once the loader lifts.
  const go = () => document.querySelectorAll('[data-intro]').forEach((el) => el.classList.add('is-in'));
  (window as any).__amanLoaded ? go() : addEventListener('loader:done', go, { once: true });

  // Journey path draws with scroll progress.
  const track = document.getElementById('journey');
  const glow = track?.querySelector<SVGPathElement>('.journey__glow');
  // Parallax images.
  const par = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const onScroll = () => {
    const vh = innerHeight;
    if (track && glow) {
      const r = track.getBoundingClientRect();
      const k = Math.min(Math.max((vh * 0.85 - r.top) / (r.height + vh * 0.35), 0), 1);
      glow.style.strokeDashoffset = String(1 - k);
    }
    for (const el of par) {
      const r = el.getBoundingClientRect();
      el.style.translate = `0 ${(r.top + r.height / 2 - vh / 2) * parseFloat(el.dataset.parallax!)}px`;
    }
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Royal rail arrows
  const rail = document.getElementById('royal-rail')!;
  const rtl = document.dir === 'rtl';
  document.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((b) =>
    b.addEventListener('click', () => rail.scrollBy({ left: +b.dataset.scroll! * (rtl ? -1 : 1) * rail.clientWidth * 0.8, behavior: 'smooth' })),
  );
  // drag-to-scroll
  let down = false, sx = 0, sl = 0;
  rail.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; sx = e.clientX; sl = rail.scrollLeft; rail.classList.add('is-drag'); });
  addEventListener('pointerup', () => { down = false; rail.classList.remove('is-drag'); });
  rail.addEventListener('pointermove', (e) => { if (down) rail.scrollLeft = sl - (e.clientX - sx); });
  rail.addEventListener('click', (e) => { if (Math.abs(rail.scrollLeft - sl) > 5 && sl !== 0) e.preventDefault(); }, true);
</script>

<style lang="scss">
  @use '../styles/mixins' as *;
  @use '../styles/tokens' as *;

  [data-intro] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s var(--ease-out), transform 1.3s var(--ease-out);
    transition-delay: calc(0.1s + var(--d) * 110ms);
    &:global(.is-in) {
      opacity: 1;
      transform: none;
    }
  }
  .hero__line > [data-intro]:not(:global(.is-in)) {
    transform: translateY(105%);
  }

  // HERO
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: calc(var(--header-h) + 40px) 0 120px;
    background: radial-gradient(90% 80% at 75% 35%, #0b5e66 0%, $teal-900 45%, $teal-950 100%);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0, 38, 43, 0.85) 0%, rgba(0, 38, 43, 0.35) 45%, transparent 70%), linear-gradient(transparent 70%, $teal-950);
    pointer-events: none;
    :global([dir='rtl']) & {
      background: linear-gradient(-90deg, rgba(0, 38, 43, 0.85) 0%, rgba(0, 38, 43, 0.35) 45%, transparent 70%), linear-gradient(transparent 70%, $teal-950);
    }
    @include down($bp-md) {
      background: linear-gradient(rgba(0, 38, 43, 0.2), rgba(0, 38, 43, 0.75) 60%, $teal-950);
    }
  }
  .hero__in {
    display: grid;
    gap: 26px;
    @include down($bp-md) {
      align-self: end;
    }
  }
  .hero__kicker {
    color: $sun-300;
  }
