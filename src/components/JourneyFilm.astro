---
// Cinematic section for the rendered 3D film (film/journey.js). The video carries no text;
// chapter captions are HTML in the page language, synced to the video's currentTime.
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { withBase } from '../lib/base';

interface Chapter { at: number; icon: IconName; title: string; text: string }
interface Props { kicker: string; title: string; chapters: Chapter[]; labels: { play: string; pause: string } }
const { kicker, title, chapters, labels } = Astro.props;
---
<section class="jf" data-film>
  <div class="jf__stage" data-reveal="clip">
    <video
      class="jf__video"
      muted
      loop
      playsinline
      preload="metadata"
      poster={withBase('/video/journey-poster.jpg')}
      aria-label={title}
    >
      <source src={withBase('/video/journey.webm')} type="video/webm" />
      <source src={withBase('/video/journey.mp4')} type="video/mp4" />
    </video>
    <div class="jf__shade" aria-hidden="true"></div>

    <div class="jf__head container">
      <p class="kicker">{kicker}</p>
      <h2 class="h2">{title}</h2>
    </div>

    <div class="jf__captions container" aria-live="polite">
      {chapters.map((c, i) => (
        <div class:list={['jf__cap', { 'is-on': i === 0 }]} data-cap={i}>
          <span class="jf__capIcon"><Icon name={c.icon} size={22} /></span>
          <div>
            <span class="jf__capN">0{i + 1} / 0{chapters.length}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        </div>
      ))}
    </div>

    <button class="jf__toggle" type="button" data-film-toggle aria-label={labels.pause} data-l-play={labels.play} data-l-pause={labels.pause}>
      <span class="jf__i jf__i--pause"><Icon name="pause" /></span>
      <span class="jf__i jf__i--play"><Icon name="play" /></span>
    </button>
  </div>

  <ol class="jf__rail container" role="list">
    {chapters.map((c, i) => (
      <li>
        <button type="button" class:list={['jf__step', { 'is-on': i === 0 }]} data-seek={c.at} data-step={i}>
          <span class="jf__bar"><i style="--k:0"></i></span>
          <span class="jf__stepIcon"><Icon name={c.icon} size={18} /></span>
          <span class="jf__stepT">{c.title}</span>
        </button>
      </li>
    ))}
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-film]').forEach((root) => {
    const video = root.querySelector('video')!;
    const caps = [...root.querySelectorAll<HTMLElement>('[data-cap]')];
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const starts = steps.map((s) => +s.dataset.seek!);
    const toggle = root.querySelector<HTMLButtonElement>('[data-film-toggle]')!;
    const motionOff = () => document.documentElement.dataset.motion === 'off';
    let userPaused = false;

    const chapterAt = (t: number) => starts.reduce((acc, s, i) => (t >= s ? i : acc), 0);
    let current = -1;
    const update = () => {
      const t = video.currentTime;
      const i = chapterAt(t);
      if (i !== current) {
        current = i;
        caps.forEach((c, k) => c.classList.toggle('is-on', k === i));
        steps.forEach((s, k) => s.classList.toggle('is-on', k === i));
      }
      steps.forEach((s, k) => {
        const end = starts[k + 1] ?? video.duration ?? 26;
        const p = k < i ? 1 : k > i ? 0 : (t - starts[k]) / (end - starts[k]);
        s.querySelector('i')!.style.setProperty('--k', String(Math.min(Math.max(p, 0), 1)));
      });
      if (!video.paused) requestAnimationFrame(update);
    };
    const setState = () => {
      root.classList.toggle('is-paused', video.paused);
      toggle.setAttribute('aria-label', video.paused ? toggle.dataset.lPlay! : toggle.dataset.lPause!);
    };
    video.addEventListener('play', () => (setState(), requestAnimationFrame(update)));
    video.addEventListener('pause', setState);
    video.addEventListener('seeked', update);

    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      video.paused ? video.play() : video.pause();
    });
    steps.forEach((s) =>
      s.addEventListener('click', () => {
        window.amanSound?.play('step');
        video.currentTime = +s.dataset.seek! + 0.05;
        if (video.paused && !motionOff()) video.play();
        update();
      }),
    );

    // Autoplay only while on screen, and never when animations are off.
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !userPaused && !motionOff()) video.play().catch(() => {});
      else if (!e.isIntersecting) video.pause();
    }, { threshold: 0.35 });
    io.observe(video);
    addEventListener('aman:settings', () => motionOff() && video.pause());
    setState();
  });
</script>

<style lang="scss">
  @use '../styles/mixins' as *;
  @use '../styles/tokens' as *;

  .jf {
    padding-block: clamp(40px, 6vw, 90px);
  }
  .jf__stage {
    position: relative;
    margin-inline: clamp(0px, 1.5vw, 20px);
    border-radius: var(--radius-l);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    min-height: 520px;
    max-height: 88vh;
    width: calc(100% - 2 * clamp(0px, 1.5vw, 20px));
    background: $teal-950;
    color: #fff;
    isolation: isolate;
    @include down($bp-md) {
      aspect-ratio: auto;
      min-height: 640px;
    }
  }
  .jf__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .jf__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 38, 43, 0.75), transparent 30%, transparent 55%, rgba(0, 38, 43, 0.9));
  }
  .jf__head {
    padding-top: clamp(28px, 4vw, 56px);
    display: grid;
    gap: 12px;
    .kicker {
      color: $sun-300;
    }
    .h2 {
      max-width: 18ch;
      font-size: clamp(1.8rem, 3.4vw, 3rem);
    }
  }
  .jf__captions {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(24px, 4vw, 48px);
  }
  .jf__cap {
    position: absolute;
    bottom: 0;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    max-width: 560px;
    padding: 20px 22px;
    border-radius: var(--radius);
    background: rgba(0, 38, 43, 0.55);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s, transform 0.8s var(--ease-out);
    pointer-events: none;
    &:global(.is-on) {
      opacity: 1;
      transform: none;
    }
    h3 {
      font-size: clamp(1.25rem, 2vw, 1.6rem);
      margin: 4px 0 6px;
    }
    p {
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.82);
      line-height: 1.55;
    }
  }
  .jf__capIcon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: $sun-500;
    color: #fff;
  }
  .jf__capN {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: $sun-300;
  }
  .jf__toggle {
    position: absolute;
    top: clamp(20px, 3vw, 36px);
    inset-inline-end: clamp(20px, 3vw, 36px);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    color: #fff;
    transition: background 0.3s, transform 0.4s var(--ease-out);
    @include focus-ring;
    &:hover {
      background: $sun-500;
      transform: scale(1.06);
    }
  }
  .jf__i {
    line-height: 0;
  }
  .jf__i--play,
  :global(.is-paused) .jf__i--pause {
    display: none;
  }
  :global(.is-paused) .jf__i--play {
    display: block;
  }
  .jf__rail {
    list-style: none;
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    @include down($bp-md) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .jf__step {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 10px;
    align-items: center;
    text-align: start;
    padding: 10px 4px;
    color: var(--text-2);
    transition: color 0.3s;
    @include focus-ring;
    &:hover,
    &:global(.is-on) {
      color: var(--text);
    }
    &:global(.is-on) .jf__stepIcon {
      background: $sun-500;
      color: #fff;
    }
  }
  .jf__bar {
    grid-column: 1 / -1;
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
    i {
      display: block;
      height: 100%;
      background: $sun-500;
      transform-origin: left;
      transform: scaleX(var(--k));
      :global([dir='rtl']) & {
        transform-origin: right;
      }
    }
  }
  .jf__stepIcon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--bg-2);
    transition: background 0.3s, color 0.3s;
  }
  .jf__stepT {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
    @include clamp-lines(2);
  }
</style>
