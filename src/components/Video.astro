---
// Click-to-load YouTube player: shows a poster + play button and only loads the iframe on demand.
interface Props { id: string; poster?: string; title?: string; label?: string }
const { id, poster, title = 'Video', label = 'Play video' } = Astro.props;
const img = poster || `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
---
<div class="vid" data-reveal="clip" data-yt={id}>
  <img src={img} alt="" loading="lazy" onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${id}/hqdefault.jpg'`} />
  <button class="vid__play" type="button" aria-label={`${label}: ${title}`}>
    <span class="vid__ring"></span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5Z" /></svg>
  </button>
  <span class="vid__title">{title}</span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    el.querySelector('button')!.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.title = el.querySelector('.vid__title')?.textContent || 'Video';
      el.classList.add('is-playing');
      el.appendChild(f);
    });
  });
</script>

<style lang="scss">
  .vid {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--teal-900);
    box-shadow: var(--shadow-lift);
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1.4s var(--ease-out), filter 0.6s;
      filter: saturate(0.9) brightness(0.8);
    }
    &:hover img {
      transform: scale(1.05);
      filter: none;
    }
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(transparent 50%, rgba(0, 38, 43, 0.75));
      pointer-events: none;
    }
    :global(iframe) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      z-index: 3;
    }
  }
  .vid__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: clamp(70px, 9vw, 110px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--sun-500);
    z-index: 2;
    transition: transform 0.6s var(--ease-out);
    svg {
      width: 36%;
      fill: #fff;
      margin-inline-start: 6%;
    }
    &:hover {
      transform: scale(1.1);
    }
    &:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 4px;
    }
  }
  .vid__ring {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    animation: ring 2.4s var(--ease-out) infinite;
  }
  @keyframes ring {
    from {
      transform: scale(0.85);
      opacity: 1;
    }
    to {
      transform: scale(1.4);
      opacity: 0;
    }
  }
  .vid__title {
    position: absolute;
    inset-inline: 28px;
    bottom: 24px;
    z-index: 2;
    color: #fff;
    font: 500 clamp(1rem, 1.6vw, 1.35rem) / 1.3 var(--font-display);
    max-width: 40ch;
  }
  .is-playing :is(.vid__play, .vid__title) {
    display: none;
  }
</style>
